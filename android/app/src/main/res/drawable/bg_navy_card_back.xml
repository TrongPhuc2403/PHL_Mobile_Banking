<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:centerColor="@color/phl_navy"
                android:endColor="@color/phl_navy_soft"
                android:startColor="@color/phl_navy_deep"
                android:type="linear" />
            <corners android:radius="@dimen/radius_xl" />
            <stroke
                android:width="1dp"
                android:color="#4DC59B27" />
        </shape>
    </item>
    <item
        android:height="34dp"
        android:left="1dp"
        android:right="1dp"
        android:top="20dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/phl_navy_deep" />
        </shape>
    </item>
</layer-list>
