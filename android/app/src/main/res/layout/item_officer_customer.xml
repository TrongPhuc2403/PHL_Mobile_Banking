<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.PHL.Card.Tile"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_md">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_base"
        android:paddingEnd="@dimen/space_base"
        android:paddingStart="@dimen/space_base"
        android:paddingTop="@dimen/space_base">

        <!-- Header row: Icon + Name/CIF + Chevron -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="@dimen/icon_badge_size"
                android:layout_height="@dimen/icon_badge_size"
                android:background="@drawable/bg_icon_circle_navy">

                <ImageView
                    android:layout_width="@dimen/icon_size_md"
                    android:layout_height="@dimen/icon_size_md"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_person"
                    app:tint="@color/phl_navy" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_sm"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCustomerName"
                    style="@style/TextAppearance.PHL.CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    tools:text="Nguyễn Hoàng Phúc" />

                <TextView
                    android:id="@+id/tvCustomerCif"
                    style="@style/TextAppearance.PHL.Pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:background="@drawable/bg_pill_navy"
                    android:fontFeatureSettings="tnum"
                    android:paddingBottom="@dimen/space_xxs"
                    android:paddingEnd="@dimen/space_sm"
                    android:paddingStart="@dimen/space_sm"
                    android:paddingTop="@dimen/space_xxs"
                    android:textColor="@color/phl_navy"
                    tools:text="CIF20260001" />
            </LinearLayout>

            <ImageView
                android:layout_width="@dimen/icon_size_md"
                android:layout_height="@dimen/icon_size_md"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/phl_text_muted" />
        </LinearLayout>

        <!-- Contact details -->
        <TextView
            android:id="@+id/tvCustomerContact"
            style="@style/TextAppearance.PHL.BodySecondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:fontFeatureSettings="tnum"
            tools:text="SĐT: 0901234567 · CCCD: 079204001234" />

        <TextView
            android:id="@+id/tvCustomerEmail"
            style="@style/TextAppearance.PHL.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxs"
            android:ellipsize="end"
            android:maxLines="1"
            android:visibility="gone"
            tools:text="phuc.nguyen@example.com"
            tools:visibility="visible" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/hairline_height"
            android:layout_marginBottom="@dimen/space_sm"
            android:layout_marginTop="@dimen/space_md"
            android:background="@color/phl_divider" />

        <!-- Status Pills Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvStatusBadge"
                style="@style/TextAppearance.PHL.Pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_emerald"
                android:paddingBottom="@dimen/space_xs"
                android:paddingEnd="@dimen/space_sm"
                android:paddingStart="@dimen/space_sm"
                android:paddingTop="@dimen/space_xs"
                android:textColor="@color/phl_emerald_dark"
                tools:text="ACTIVE" />

            <TextView
                android:id="@+id/tvEkycBadge"
                style="@style/TextAppearance.PHL.Pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:background="@drawable/bg_pill_gold"
                android:paddingBottom="@dimen/space_xs"
                android:paddingEnd="@dimen/space_sm"
                android:paddingStart="@dimen/space_sm"
                android:paddingTop="@dimen/space_xs"
                android:textColor="@color/phl_gold"
                tools:text="eKYC: VERIFIED" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvAccountsBadge"
                style="@style/TextAppearance.PHL.Pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_navy"
                android:fontFeatureSettings="tnum"
                android:paddingBottom="@dimen/space_xs"
                android:paddingEnd="@dimen/space_sm"
                android:paddingStart="@dimen/space_sm"
                android:paddingTop="@dimen/space_xs"
                android:textColor="@color/phl_navy"
                tools:text="2 TK" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
