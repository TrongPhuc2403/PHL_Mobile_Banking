<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_xl"
        android:paddingEnd="@dimen/space_lg"
        android:paddingStart="@dimen/space_lg"
        android:paddingTop="@dimen/space_md">

        <View
            android:layout_width="@dimen/sheet_handle_width"
            android:layout_height="@dimen/sheet_handle_height"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_sheet_handle" />

        <!-- Header -->
        <LinearLayout
            android:id="@+id/layoutEditCustomerHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_base"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="@dimen/avatar_size_md"
                android:layout_height="@dimen/avatar_size_md"
                android:background="@drawable/bg_navy_crest_circle">

                <ImageView
                    android:layout_width="@dimen/icon_size_lg"
                    android:layout_height="@dimen/icon_size_lg"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_edit"
                    app:tint="@color/phl_gold_light" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.PHL.Overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HỒ SƠ KHÁCH HÀNG" />

                <TextView
                    android:id="@+id/tvEditCustomerName"
                    style="@style/TextAppearance.PHL.Headline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xxs"
                    tools:text="Nguyễn Hoàng Phúc" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvEditCustomerCif"
                        style="@style/TextAppearance.PHL.Pill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_navy"
                        android:fontFeatureSettings="tnum"
                        android:paddingBottom="@dimen/space_xxs"
                        android:paddingEnd="@dimen/space_sm"
                        android:paddingStart="@dimen/space_sm"
                        android:paddingTop="@dimen/space_xxs"
                        android:textColor="@color/phl_navy"
                        tools:text="CIF20260001" />

                    <TextView
                        android:id="@+id/tvEditStatusPill"
                        style="@style/TextAppearance.PHL.Pill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_sm"
                        android:background="@drawable/bg_pill_emerald"
                        android:paddingBottom="@dimen/space_xxs"
                        android:paddingEnd="@dimen/space_sm"
                        android:paddingStart="@dimen/space_sm"
                        android:paddingTop="@dimen/space_xxs"
                        android:textColor="@color/phl_emerald_dark"
                        tools:text="ACTIVE" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/hairline_height"
            android:layout_marginTop="@dimen/space_base"
            android:background="@drawable/bg_gold_hairline" />

        <!-- Inline Error Banner -->
        <TextView
            android:id="@+id/tvEditCustomerError"
            style="@style/TextAppearance.PHL.BodySecondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_base"
            android:background="@drawable/bg_error_banner"
            android:paddingBottom="@dimen/space_sm"
            android:paddingEnd="@dimen/space_md"
            android:paddingStart="@dimen/space_md"
            android:paddingTop="@dimen/space_sm"
            android:textColor="@color/phl_danger"
            android:visibility="gone" />

        <!-- Contact Form -->
        <LinearLayout
            android:id="@+id/layoutEditCustomerForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_base"
            android:orientation="vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEditPhone"
                style="@style/Widget.PHL.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Số điện thoại (tối thiểu 9 số)">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtEditPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:imeOptions="actionNext"
                    android:inputType="phone"
                    android:maxLength="20"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEditEmail"
                style="@style/Widget.PHL.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:hint="Email liên hệ">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtEditEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="textEmailAddress"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEditAddress"
                style="@style/Widget.PHL.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:hint="Địa chỉ liên hệ">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtEditAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="textPostalAddress"
                    android:maxLength="255"
                    android:maxLines="2" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressEditCustomer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/phl_navy"
            app:trackColor="@color/phl_navy_tint" />

        <!-- Actions -->
        <LinearLayout
            android:id="@+id/layoutEditCustomerActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEnrollCustomerEkyc"
                style="@style/Widget.PHL.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_sm"
                android:text="Đăng ký ảnh gốc eKYC (camera)"
                app:icon="@drawable/ic_phl_shield" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveCustomerContact"
                style="@style/Widget.PHL.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lưu thông tin liên hệ" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleCustomerStatus"
                style="@style/Widget.PHL.Button.Outlined.Danger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="Khóa tài khoản"
                app:icon="@drawable/ic_lock"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCloseCustomerEdit"
                style="@style/Widget.PHL.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="Đóng" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
