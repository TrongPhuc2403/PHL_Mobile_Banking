<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_xl"
        android:paddingEnd="@dimen/space_lg"
        android:paddingStart="@dimen/space_lg"
        android:paddingTop="@dimen/space_md">

        <View
            android:layout_width="@dimen/sheet_handle_width"
            android:layout_height="@dimen/sheet_handle_height"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_sheet_handle" />

        <LinearLayout
            android:id="@+id/layoutSheetHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_base"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.PHL.Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PHL SECURITY CHECK" />

            <TextView
                style="@style/TextAppearance.PHL.Headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:text="Xác nhận giao dịch" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/hairline_height"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_gold_hairline" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardConfirmSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_base"
            android:background="@drawable/bg_m3_surface_subtle_card"
            android:orientation="vertical"
            android:padding="@dimen/space_base">

            <TextView
                android:id="@+id/tvConfirmSummary"
                style="@style/TextAppearance.PHL.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:lineSpacingMultiplier="1.35" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/boxEkycStep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/bg_error_banner"
            android:orientation="vertical"
            android:padding="@dimen/space_md"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgEkycStepIcon"
                    android:layout_width="@dimen/icon_size_md"
                    android:layout_height="@dimen/icon_size_md"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/phl_danger" />

                <TextView
                    android:id="@+id/tvEkycStepNote"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:layout_weight="1"
                    android:fontFeatureSettings="tnum"
                    android:text="Giao dịch trên 10.000.000 VNĐ yêu cầu xác minh khuôn mặt eKYC trước bước OTP."
                    android:textColor="@color/phl_danger"
                    android:textSize="@dimen/text_body_sm"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerifyEkyc"
                style="@style/Widget.PHL.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="Xác minh khuôn mặt eKYC"
                app:icon="@drawable/ic_phl_shield"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/space_sm"
                app:iconTint="@color/phl_navy" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSecurityProgress"
            style="@style/TextAppearance.PHL.BodySecondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:text="1 · Kiểm tra giao dịch → 2 · OTP → 3 · Hoàn tất"
            android:accessibilityLiveRegion="polite" />

        <TextView
            android:id="@+id/tvOtpBanner"
            style="@style/TextAppearance.PHL.BodySecondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:background="@drawable/bg_m2_success_banner"
            android:padding="@dimen/space_sm"
            android:text="OTP sẽ hiển thị tại đây sau khi được gửi."
            android:visibility="visible"
            android:accessibilityLiveRegion="polite" />

        <LinearLayout
            android:id="@+id/layoutOtpRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.PHL.TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_sm"
                android:layout_weight="1"
                android:hint="Mã OTP (6 số)">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtConfirmOtp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:inputType="number"
                    android:letterSpacing="0.16"
                    android:maxLength="6" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSendOtp"
                style="@style/Widget.PHL.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lấy OTP" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExecuteTransaction"
            style="@style/Widget.PHL.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="Xác nhận &amp; Thực hiện" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
