<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="@dimen/space_lg">
        <TextView style="@style/TextAppearance.PHL.BodySecondary"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="1 · Xác nhận tài khoản → 2 · Chụp hai ảnh → 3 · Lưu ảnh gốc
Chỉ đăng ký lần đầu cho tài khoản của bạn. Không thể tự thay ảnh gốc đã có." />
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEnrollmentPassword" style="@style/Widget.PHL.TextInputLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md" android:hint="Mật khẩu hiện tại" app:endIconMode="password_toggle">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtEnrollmentPassword" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textPassword" android:imeOptions="actionDone" android:maxLength="200"
                android:saveEnabled="false" android:importantForAutofill="no" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSendEnrollmentOtp" style="@style/Widget.PHL.Button.Outlined"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm" android:text="Xác nhận mật khẩu và gửi OTP" />
        <TextView android:id="@+id/tvEnrollmentOtpNote" style="@style/TextAppearance.PHL.BodySecondary"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone"
            android:layout_marginTop="@dimen/space_sm" android:accessibilityLiveRegion="polite" />
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEnrollmentOtp" style="@style/Widget.PHL.TextInputLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone"
            android:layout_marginTop="@dimen/space_md" android:hint="OTP đăng ký (6 số)">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtEnrollmentOtp" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="number" android:maxLength="6" android:saveEnabled="false" android:importantForAutofill="no" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:id="@+id/tvEnrollmentError" style="@style/TextAppearance.PHL.BodySecondary"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone"
            android:layout_marginTop="@dimen/space_sm" android:textColor="@color/phl_danger" android:accessibilityLiveRegion="polite" />
        <ProgressBar android:id="@+id/progressEnrollment" style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal"
            android:visibility="gone" android:layout_marginTop="@dimen/space_sm" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmEnrollmentOtp" style="@style/Widget.PHL.Button.Primary"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:enabled="false"
            android:layout_marginTop="@dimen/space_md" android:text="Xác nhận OTP và mở camera" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelEnrollment" style="@style/Widget.PHL.Button.Outlined"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm" android:text="Để sau" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
