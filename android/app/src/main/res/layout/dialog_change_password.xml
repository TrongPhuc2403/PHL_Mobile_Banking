<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_xl"
        android:paddingEnd="@dimen/space_lg"
        android:paddingStart="@dimen/space_lg"
        android:paddingTop="@dimen/space_md">

        <View
            android:layout_width="@dimen/sheet_handle_width"
            android:layout_height="@dimen/sheet_handle_height"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_sheet_handle" />

        <LinearLayout
            android:id="@+id/layoutChangePasswordHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_base"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <FrameLayout
                android:layout_width="@dimen/avatar_size_md"
                android:layout_height="@dimen/avatar_size_md"
                android:background="@drawable/bg_navy_crest_circle">
                <ImageView
                    android:layout_width="@dimen/icon_size_lg"
                    android:layout_height="@dimen/icon_size_lg"
                    android:layout_gravity="center"
                    android:contentDescription="@string/change_pw_title"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/phl_gold_light" />
            </FrameLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView style="@style/TextAppearance.PHL.Overline" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/change_pw_overline" />
                <TextView style="@style/TextAppearance.PHL.Headline" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_xxs" android:text="@string/change_pw_title" />
                <TextView style="@style/TextAppearance.PHL.BodySecondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_xxs" android:text="@string/change_pw_subtitle" />
            </LinearLayout>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="@dimen/hairline_height" android:layout_marginTop="@dimen/space_base" android:background="@drawable/bg_gold_hairline" />
        <TextView android:id="@+id/tvChangePasswordError" style="@style/TextAppearance.PHL.BodySecondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_base" android:background="@drawable/bg_error_banner" android:paddingBottom="@dimen/space_sm" android:paddingEnd="@dimen/space_md" android:paddingStart="@dimen/space_md" android:paddingTop="@dimen/space_sm" android:textColor="@color/phl_danger" android:visibility="gone" />
        <LinearLayout
            android:id="@+id/layoutChangePasswordForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_base"
            android:orientation="vertical">
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilCurrentPassword" style="@style/Widget.PHL.TextInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/change_pw_current" app:endIconMode="password_toggle">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/edtCurrentPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:imeOptions="actionNext" android:inputType="textPassword" android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilNewPassword" style="@style/Widget.PHL.TextInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_md" android:hint="@string/change_pw_new" app:endIconMode="password_toggle">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/edtNewPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:imeOptions="actionNext" android:inputType="textPassword" android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilConfirmPassword" style="@style/Widget.PHL.TextInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_md" android:hint="@string/change_pw_confirm" app:endIconMode="password_toggle">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/edtConfirmPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:imeOptions="actionNext" android:inputType="textPassword" android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:id="@+id/tvOtpBanner" style="@style/TextAppearance.PHL.BodySecondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_md" android:background="@drawable/bg_error_banner" android:padding="@dimen/space_sm" android:text="Mã OTP sẽ được gửi đến số điện thoại đã đăng ký." android:visibility="visible" />
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilOtpCode" style="@style/Widget.PHL.TextInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_sm" android:hint="Mã OTP">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/edtOtpCode" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:maxLength="6" android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnRequestOtp" style="@style/Widget.PHL.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_sm" android:text="Gửi mã OTP" />
        </LinearLayout>
        <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/progressChangePassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_md" android:indeterminate="true" android:visibility="gone" app:indicatorColor="@color/phl_navy" app:trackColor="@color/phl_navy_tint" />
        <LinearLayout android:id="@+id/layoutChangePasswordActions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_lg" android:orientation="vertical">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnConfirmChangePassword" style="@style/Widget.PHL.Button.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/change_pw_submit" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCancelChangePassword" style="@style/Widget.PHL.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_sm" android:text="@string/change_pw_cancel" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
