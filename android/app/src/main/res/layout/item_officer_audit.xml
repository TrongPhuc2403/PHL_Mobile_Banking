<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <!-- Left Timeline Rail -->
    <LinearLayout
        android:layout_width="20dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="@dimen/space_sm"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <View
            android:layout_width="1.5dp"
            android:layout_height="18dp"
            android:background="@color/phl_border" />

        <View
            android:id="@+id/vAuditTimelineDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_m4_dot_navy" />

        <View
            android:layout_width="1.5dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/phl_border" />
    </LinearLayout>

    <!-- Right Timeline Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardAuditItem"
        style="@style/Widget.PHL.Card.Tile"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_md"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_md"
            android:paddingEnd="@dimen/space_base"
            android:paddingStart="@dimen/space_base"
            android:paddingTop="@dimen/space_md">

            <!-- Header row: Action pill + Entity + Expand chevron -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvAuditActionBadge"
                    style="@style/TextAppearance.PHL.Pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_emerald"
                    android:paddingBottom="@dimen/space_xxs"
                    android:paddingEnd="@dimen/space_sm"
                    android:paddingStart="@dimen/space_sm"
                    android:paddingTop="@dimen/space_xxs"
                    android:textColor="@color/phl_emerald_dark"
                    tools:text="CREATE" />

                <TextView
                    android:id="@+id/tvAuditEntity"
                    style="@style/TextAppearance.PHL.CardTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:layout_marginStart="@dimen/space_sm"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    tools:text="CustomerProfile #12" />

                <ImageView
                    android:id="@+id/ivAuditExpand"
                    android:layout_width="@dimen/icon_size_md"
                    android:layout_height="@dimen/icon_size_md"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/phl_text_muted" />
            </LinearLayout>

            <!-- Meta row: Actor + Timestamp -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvAuditActorBadge"
                    style="@style/TextAppearance.PHL.Pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_navy"
                    android:paddingBottom="@dimen/space_xxs"
                    android:paddingEnd="@dimen/space_sm"
                    android:paddingStart="@dimen/space_sm"
                    android:paddingTop="@dimen/space_xxs"
                    android:textColor="@color/phl_navy"
                    tools:text="@officer1" />

                <TextView
                    android:id="@+id/tvAuditTimestamp"
                    style="@style/TextAppearance.PHL.Caption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFeatureSettings="tnum"
                    android:gravity="end"
                    android:maxLines="1"
                    tools:text="2026-11-26 19:45:12" />
            </LinearLayout>

            <!-- Highlight Row (Formatted VND or Rate) -->
            <LinearLayout
                android:id="@+id/layoutAuditHighlight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/tvAuditHighlightLabel"
                    style="@style/TextAppearance.PHL.Caption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:text="Số tiền nạp ban đầu" />

                <TextView
                    android:id="@+id/tvAuditHighlightValue"
                    style="@style/TextAppearance.PHL.Amount.Row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/phl_emerald_dark"
                    tools:text="5.000.000 VNĐ" />
            </LinearLayout>

            <!-- Expandable Diff Surface -->
            <LinearLayout
                android:id="@+id/layoutAuditDiffPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_m4_diff_surface"
                android:orientation="vertical"
                android:paddingBottom="@dimen/space_sm"
                android:paddingEnd="@dimen/space_md"
                android:paddingStart="@dimen/space_md"
                android:paddingTop="@dimen/space_sm"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    style="@style/TextAppearance.PHL.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Giá trị trước"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAuditOldValue"
                    style="@style/TextAppearance.PHL.BodySecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xxs"
                    android:fontFeatureSettings="tnum"
                    tools:text="Không có" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/hairline_height"
                    android:layout_marginBottom="@dimen/space_sm"
                    android:layout_marginTop="@dimen/space_sm"
                    android:background="@color/phl_divider" />

                <TextView
                    style="@style/TextAppearance.PHL.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Giá trị sau"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAuditNewValue"
                    style="@style/TextAppearance.PHL.BodySecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xxs"
                    android:fontFeatureSettings="tnum"
                    tools:text="CIF: CIF20260001 · STK: 190010000001 · Số tiền: 5.000.000 VNĐ" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
