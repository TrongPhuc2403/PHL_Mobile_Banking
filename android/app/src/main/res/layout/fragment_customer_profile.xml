<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/phl_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/layoutProfileBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_navy_hero"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="@dimen/space_lg"
            android:paddingEnd="@dimen/space_lg"
            android:paddingStart="@dimen/space_lg"
            android:paddingTop="@dimen/space_xl">

            <FrameLayout
                android:id="@+id/avatarProfileCrest"
                android:layout_width="@dimen/avatar_size_lg"
                android:layout_height="@dimen/avatar_size_lg"
                android:background="@drawable/bg_navy_crest_circle">

                <TextView
                    android:id="@+id/tvProfileMonogram"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="PH"
                    android:textColor="@color/phl_gold_light"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_base"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.PHL.Overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PHL PRIVATE CLIENT" />

                <TextView
                    android:id="@+id/tvProfileHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xxs"
                    android:fontFeatureSettings="tnum"
                    android:text="Khách hàng"
                    android:textColor="@color/phl_white"
                    android:textSize="@dimen/text_section"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:background="@drawable/bg_pill_navy_dark"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingBottom="@dimen/space_xs"
                    android:paddingEnd="@dimen/space_sm"
                    android:paddingStart="@dimen/space_sm"
                    android:paddingTop="@dimen/space_xs">

                    <ImageView
                        android:layout_width="@dimen/icon_size_sm"
                        android:layout_height="@dimen/icon_size_sm"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_check_verified"
                        app:tint="@color/phl_gold_light" />

                    <TextView
                        style="@style/TextAppearance.PHL.Pill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_xs"
                        android:text="Xác thực Private Banking"
                        android:textColor="@color/phl_gold_light" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/hairline_height"
            android:background="@drawable/bg_gold_hairline" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_base">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProfileBiometric"
                style="@style/Widget.PHL.Card.Elevated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="@dimen/space_base">
                    <TextView style="@style/TextAppearance.PHL.CardTitle"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Sinh trắc học khuôn mặt" />
                    <TextView
                        android:id="@+id/tvProfileEkycStatus"
                        style="@style/TextAppearance.PHL.BodySecondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:text="Đang kiểm tra sinh trắc học..."
                        android:accessibilityLiveRegion="polite" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnProfileEkyc"
                        style="@style/Widget.PHL.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:text="Đăng ký sinh trắc học ngay"
                        app:icon="@drawable/ic_phl_shield" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProfileContact"
                style="@style/Widget.PHL.Card.Elevated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_base">

                    <TextView
                        style="@style/TextAppearance.PHL.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thông tin liên lạc" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.PHL.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:hint="Số điện thoại">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtProfilePhone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:inputType="phone" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.PHL.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:hint="Email">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtProfileEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textEmailAddress" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.PHL.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:hint="Địa chỉ liên lạc">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtProfileAddress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPostalAddress" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveContact"
                        style="@style/Widget.PHL.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_base"
                        android:text="Cập nhật thông tin liên lạc" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProfileNotifications"
                style="@style/Widget.PHL.Card.Elevated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_base">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextAppearance.PHL.CardTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Thông báo chính sách &amp; Biến động" />

                        <TextView
                            android:id="@+id/tvPolicyCountBadge"
                            style="@style/TextAppearance.PHL.Pill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_gold"
                            android:fontFeatureSettings="tnum"
                            android:paddingBottom="@dimen/space_xs"
                            android:paddingEnd="@dimen/space_sm"
                            android:paddingStart="@dimen/space_sm"
                            android:paddingTop="@dimen/space_xs"
                            android:text="0"
                            android:textColor="@color/phl_gold"
                            android:visibility="gone" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/containerPolicyAlerts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:orientation="vertical"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvNotificationsBody"
                        style="@style/TextAppearance.PHL.BodySecondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:text="Đang tải thông báo..." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProfileSecurity"
                style="@style/Widget.PHL.Card.Elevated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_base">

                    <TextView
                        style="@style/TextAppearance.PHL.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bảo mật &amp; Phiên đăng nhập" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCustomerChangePassword"
                        style="@style/Widget.PHL.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:text="Đổi mật khẩu"
                        app:icon="@drawable/ic_lock"
                        app:iconGravity="textStart"
                        app:iconPadding="@dimen/space_sm"
                        app:iconTint="@color/phl_navy" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCustomerLogout"
                        style="@style/Widget.PHL.Button.Outlined.Danger"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:text="@string/action_logout"
                        app:icon="@drawable/ic_m3_logout"
                        app:iconGravity="textStart"
                        app:iconPadding="@dimen/space_sm"
                        app:iconTint="@color/phl_danger" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
