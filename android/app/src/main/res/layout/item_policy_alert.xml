<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_sm"
    android:background="@drawable/bg_luxury_card"
    android:gravity="top"
    android:orientation="horizontal"
    android:padding="@dimen/space_md">

    <FrameLayout
        android:layout_width="@dimen/icon_badge_size"
        android:layout_height="@dimen/icon_badge_size"
        android:background="@drawable/bg_icon_circle_gold">

        <ImageView
            android:layout_width="@dimen/icon_size_md"
            android:layout_height="@dimen/icon_size_md"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_phl_shield"
            app:tint="@color/phl_gold" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_md"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPolicyTitle"
            style="@style/TextAppearance.PHL.CardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Thông báo" />

        <TextView
            android:id="@+id/tvPolicyMessage"
            style="@style/TextAppearance.PHL.BodySecondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="--" />

        <TextView
            android:id="@+id/tvPolicyDate"
            style="@style/TextAppearance.PHL.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:fontFeatureSettings="tnum"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
