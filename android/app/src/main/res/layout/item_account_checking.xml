<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.PHL.Card.Hero"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_md"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:id="@+id/cardFlipContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="208dp">

        <!-- Front Face -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutCheckingFront"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_navy_card_prestige"
            android:minHeight="208dp"
            android:visibility="visible">

            <View
                android:id="@+id/viewCheckingShimmer"
                android:layout_width="110dp"
                android:layout_height="0dp"
                android:background="@drawable/bg_shimmer_sweep"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_lg"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="36dp"
                        android:layout_height="26dp"
                        android:background="@drawable/bg_m2_emv_chip" />

                    <TextView
                        style="@style/TextAppearance.PHL.Overline"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:layout_weight="1"
                        android:text="TÀI KHOẢN THANH TOÁN"
                        android:textColor="@color/phl_gold_light" />

                    <TextView
                        android:id="@+id/tvCheckingStatus"
                        style="@style/TextAppearance.PHL.Pill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_emerald"
                        android:paddingStart="@dimen/space_sm"
                        android:paddingTop="@dimen/space_xxs"
                        android:paddingEnd="@dimen/space_sm"
                        android:paddingBottom="@dimen/space_xxs"
                        android:text="ACTIVE"
                        android:textColor="@color/phl_emerald_dark" />

                    <ImageView
                        android:layout_width="@dimen/icon_size_md"
                        android:layout_height="@dimen/icon_size_md"
                        android:layout_marginStart="@dimen/space_sm"
                        android:contentDescription="Lật thẻ"
                        android:src="@drawable/ic_m2_flip" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvCheckingAccountNo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:fontFeatureSettings="tnum"
                    android:letterSpacing="0.06"
                    android:textColor="@color/phl_gold_light"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/hairline_height"
                    android:layout_marginTop="@dimen/space_md"
                    android:background="@drawable/bg_gold_hairline" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:text="Số dư khả dụng"
                    android:textColor="@color/phl_navy_on_dark_muted"
                    android:textSize="@dimen/text_body_sm" />

                <TextView
                    android:id="@+id/tvCheckingAvailable"
                    style="@style/TextAppearance.PHL.Amount.Hero"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xxs"
                    android:fontFeatureSettings="tnum"
                    android:text="0 VNĐ" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCheckingTransfer"
                        style="@style/Widget.PHL.Button.Text.Light"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:paddingStart="@dimen/space_xxs"
                        android:paddingEnd="@dimen/space_xxs"
                        android:text="Chuyển tiền" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCheckingDeposit"
                        style="@style/Widget.PHL.Button.Text.Light"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:paddingStart="@dimen/space_xxs"
                        android:paddingEnd="@dimen/space_xxs"
                        android:text="Nạp tiền" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCheckingWithdraw"
                        style="@style/Widget.PHL.Button.Text.Light"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:paddingStart="@dimen/space_xxs"
                        android:paddingEnd="@dimen/space_xxs"
                        android:text="Rút tiền" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="Chạm thẻ để xem chi tiết"
                    android:textColor="@color/phl_navy_on_dark_subtle"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Back Face -->
        <LinearLayout
            android:id="@+id/layoutCheckingBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_navy_card_back"
            android:minHeight="208dp"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_lg"
            android:paddingTop="64dp"
            android:paddingEnd="@dimen/space_lg"
            android:paddingBottom="@dimen/space_lg"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvCheckingBackAccountNo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:letterSpacing="0.05"
                android:textColor="@color/phl_gold_light"
                android:textSize="@dimen/text_body_md"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Số dư hiện tại"
                    android:textColor="@color/phl_navy_on_dark_muted"
                    android:textSize="@dimen/text_body_md" />

                <TextView
                    android:id="@+id/tvCheckingBackCurrent"
                    style="@style/TextAppearance.PHL.AmountSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/phl_white" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Số dư khả dụng"
                    android:textColor="@color/phl_navy_on_dark_muted"
                    android:textSize="@dimen/text_body_md" />

                <TextView
                    android:id="@+id/tvCheckingBackAvailable"
                    style="@style/TextAppearance.PHL.AmountSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/phl_emerald_stroke" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvCheckingBackStatus"
                    style="@style/TextAppearance.PHL.Pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_navy_dark"
                    android:paddingStart="@dimen/space_sm"
                    android:paddingTop="@dimen/space_xxs"
                    android:paddingEnd="@dimen/space_sm"
                    android:paddingBottom="@dimen/space_xxs"
                    android:textColor="@color/phl_gold_light" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="Chạm để lật lại"
                    android:textColor="@color/phl_navy_on_dark_subtle"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
