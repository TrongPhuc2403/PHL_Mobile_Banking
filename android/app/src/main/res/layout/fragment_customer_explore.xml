<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutExploreRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/phl_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/layoutExploreHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_navy_hero"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_base"
        android:paddingEnd="@dimen/space_lg"
        android:paddingStart="@dimen/space_lg"
        android:paddingTop="@dimen/space_lg">

        <TextView
            style="@style/TextAppearance.PHL.Overline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PHL CONCIERGE &amp; BRANCHES" />

        <TextView
            style="@style/TextAppearance.PHL.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="Chi nhánh &amp; Trợ lý AI"
            android:textColor="@color/phl_white" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipExploreMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="@dimen/space_sm"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMapBranch"
                    style="@style/Widget.PHL.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Chi nhánh &amp; Đường đi bộ"
                    app:chipIcon="@drawable/ic_explore"
                    app:chipIconSize="@dimen/icon_size_sm" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAiAssistant"
                    style="@style/Widget.PHL.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trợ lý AI PHL"
                    app:chipIcon="@drawable/ic_ai_sparkle"
                    app:chipIconSize="@dimen/icon_size_sm" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/hairline_height"
        android:background="@drawable/bg_gold_hairline" />

    <!-- Map & Branches Section -->
    <ScrollView
        android:id="@+id/panelMapBranches"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_base">

            <!-- Fallback notice when GPS/permission is unavailable -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLocationFallback"
                style="@style/Widget.PHL.Card.Tile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_md"
                android:visibility="gone"
                app:cardBackgroundColor="@color/phl_warning_tint">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_base">

                    <TextView
                        android:id="@+id/tvLocationFallback"
                        style="@style/TextAppearance.PHL.BodySecondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityLiveRegion="polite"
                        android:textColor="@color/phl_text_primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRequestLocation"
                        style="@style/Widget.PHL.Button.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:text="Cấp quyền / Thử lại GPS" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvBranchStatus"
                style="@style/TextAppearance.PHL.BodySecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_sm"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetryBranches"
                style="@style/Widget.PHL.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_sm"
                android:text="Tải lại chi nhánh"
                android:visibility="gone" />

            <!-- Interactive OSMDroid Map -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMapContainer"
                style="@style/Widget.PHL.Card.Elevated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_md"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <org.osmdroid.views.MapView
                        android:id="@+id/mapBranches"
                        android:layout_width="match_parent"
                        android:layout_height="260dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="@dimen/space_sm"
                        android:paddingEnd="@dimen/space_base"
                        android:paddingStart="@dimen/space_base"
                        android:paddingTop="@dimen/space_sm">

                        <TextView
                            style="@style/TextAppearance.PHL.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="● Vị trí của bạn"
                            android:textColor="@color/phl_info" />

                        <TextView
                            style="@style/TextAppearance.PHL.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="● Chi nhánh PHL Bank"
                            android:textColor="@color/phl_danger" />

                        <TextView
                            style="@style/TextAppearance.PHL.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="● Chi nhánh gần nhất"
                            android:textColor="@color/phl_emerald_dark" />

                        <TextView
                            style="@style/TextAppearance.PHL.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:text="© OpenStreetMap contributors" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNearestBranch"
                style="@style/Widget.PHL.Card.Elevated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_base">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:id="@+id/badgeNearestPin"
                            android:layout_width="@dimen/icon_badge_size"
                            android:layout_height="@dimen/icon_badge_size"
                            android:background="@drawable/bg_icon_circle_gold">

                            <ImageView
                                android:layout_width="@dimen/icon_size_md"
                                android:layout_height="@dimen/icon_size_md"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_explore"
                                app:tint="@color/phl_gold" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_md"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.PHL.Overline"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="NEAREST BRANCH" />

                            <TextView
                                style="@style/TextAppearance.PHL.CardTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Chi nhánh gần bạn nhất" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvNearestDistancePill"
                            style="@style/TextAppearance.PHL.Pill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_navy"
                            android:fontFeatureSettings="tnum"
                            android:paddingBottom="@dimen/space_xs"
                            android:paddingEnd="@dimen/space_sm"
                            android:paddingStart="@dimen/space_sm"
                            android:paddingTop="@dimen/space_xs"
                            android:text="0 m"
                            android:textColor="@color/phl_navy"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tvNearestWalkPill"
                            style="@style/TextAppearance.PHL.Pill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_sm"
                            android:background="@drawable/bg_pill_emerald"
                            android:fontFeatureSettings="tnum"
                            android:paddingBottom="@dimen/space_xs"
                            android:paddingEnd="@dimen/space_sm"
                            android:paddingStart="@dimen/space_sm"
                            android:paddingTop="@dimen/space_xs"
                            android:text="0 phút đi bộ"
                            android:textColor="@color/phl_emerald_dark"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvNearestBranch"
                        style="@style/TextAppearance.PHL.BodySecondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:fontFeatureSettings="tnum" />

                    <TextView
                        android:id="@+id/tvWalkingRouteNote"
                        style="@style/TextAppearance.PHL.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:textColor="@color/phl_text_muted"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenWalkingMap"
                        style="@style/Widget.PHL.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:text="Chỉ đường"
                        app:icon="@drawable/ic_explore"
                        app:iconGravity="textStart"
                        app:iconPadding="@dimen/space_sm"
                        app:iconTint="@color/phl_white" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/containerBranchList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.PHL.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Danh sách chi nhánh PHL Bank" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvBranchList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- AI Chatbot Section -->
    <LinearLayout
        android:id="@+id/panelAiChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="@dimen/space_base"
        android:visibility="gone">

        <ScrollView
            android:id="@+id/scrollAiMessages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/containerAiMessages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <LinearLayout
            android:id="@+id/layoutAiTyping"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:accessibilityLiveRegion="polite"
            android:background="@drawable/bg_chat_ai"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="@dimen/space_sm"
            android:paddingEnd="@dimen/space_md"
            android:paddingStart="@dimen/space_md"
            android:paddingTop="@dimen/space_sm"
            android:visibility="gone">

            <TextView
                style="@style/TextAppearance.PHL.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đang trả lời..."
                android:textColor="@color/phl_navy" />

            <View
                android:id="@+id/typingDot1"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginStart="@dimen/space_sm"
                android:background="@drawable/bg_m3_typing_dot" />

            <View
                android:id="@+id/typingDot2"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginStart="@dimen/space_xs"
                android:background="@drawable/bg_m3_typing_dot" />

            <View
                android:id="@+id/typingDot3"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginStart="@dimen/space_xs"
                android:background="@drawable/bg_m3_typing_dot" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPromptTransfer"
                    style="@style/Widget.PHL.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="false"
                    android:text="Chuyển tiền" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPromptSavings"
                    style="@style/Widget.PHL.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:checkable="false"
                    android:text="Gửi tiết kiệm" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPromptBranch"
                    style="@style/Widget.PHL.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:checkable="false"
                    android:text="Chi nhánh gần nhất" />
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.PHL.TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_sm"
                android:layout_weight="1"
                android:hint="Hỏi về chuyển tiền, tiết kiệm, chi nhánh...">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtAiPrompt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSendAi"
                style="@style/Widget.PHL.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gửi" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
