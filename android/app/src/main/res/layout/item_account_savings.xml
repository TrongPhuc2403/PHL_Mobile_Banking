<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.PHL.Card.Hero"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_md"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:id="@+id/cardFlipContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="216dp">

        <!-- Front Face -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutSavingsFront"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_m2_savings_card_front"
            android:minHeight="216dp"
            android:visibility="visible">

            <View
                android:id="@+id/viewSavingsShimmer"
                android:layout_width="110dp"
                android:layout_height="0dp"
                android:background="@drawable/bg_shimmer_sweep"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_lg"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/TextAppearance.PHL.Overline"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="TÀI KHOẢN TIẾT KIỆM"
                        android:textColor="@color/phl_gold_light" />

                    <TextView
                        android:id="@+id/tvSavingsTermBadge"
                        style="@style/TextAppearance.PHL.Pill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_gold"
                        android:fontFeatureSettings="tnum"
                        android:paddingStart="@dimen/space_sm"
                        android:paddingTop="@dimen/space_xxs"
                        android:paddingEnd="@dimen/space_sm"
                        android:paddingBottom="@dimen/space_xxs"
                        android:textColor="@color/phl_gold" />

                    <ImageView
                        android:layout_width="@dimen/icon_size_md"
                        android:layout_height="@dimen/icon_size_md"
                        android:layout_marginStart="@dimen/space_sm"
                        android:contentDescription="Lật thẻ"
                        android:src="@drawable/ic_m2_flip" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvSavingsAccountNo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:fontFeatureSettings="tnum"
                    android:letterSpacing="0.06"
                    android:textColor="@color/phl_gold_light"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/hairline_height"
                    android:layout_marginTop="@dimen/space_md"
                    android:background="@drawable/bg_gold_hairline" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:text="Số dư gốc tiết kiệm"
                    android:textColor="@color/phl_navy_on_dark_muted"
                    android:textSize="@dimen/text_body_sm" />

                <TextView
                    android:id="@+id/tvSavingsBalance"
                    style="@style/TextAppearance.PHL.Amount.Hero"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xxs"
                    android:fontFeatureSettings="tnum"
                    android:text="0 VNĐ" />

                <TextView
                    android:id="@+id/tvSavingsMaturity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:textColor="@color/phl_navy_on_dark_muted"
                    android:textSize="@dimen/text_body_sm" />

                <TextView
                    android:id="@+id/tvSavingsAccrued"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/phl_emerald_stroke"
                    android:textSize="@dimen/text_body_md"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="Chạm thẻ để xem kỳ hạn &amp; lãi suất"
                    android:textColor="@color/phl_navy_on_dark_subtle"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Back Face -->
        <LinearLayout
            android:id="@+id/layoutSavingsBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_m2_savings_card_back"
            android:minHeight="216dp"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_lg"
            android:paddingTop="64dp"
            android:paddingEnd="@dimen/space_lg"
            android:paddingBottom="@dimen/space_lg"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvSavingsBackProduct"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/phl_gold_light"
                    android:textSize="@dimen/text_body_md"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSavingsBackRate"
                    style="@style/TextAppearance.PHL.Amount.Rate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/phl_emerald_stroke" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Kỳ hạn gửi"
                    android:textColor="@color/phl_navy_on_dark_muted"
                    android:textSize="@dimen/text_body_md" />

                <TextView
                    android:id="@+id/tvSavingsBackTerm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/phl_white"
                    android:textSize="@dimen/text_body_md"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Ngày đáo hạn"
                    android:textColor="@color/phl_navy_on_dark_muted"
                    android:textSize="@dimen/text_body_md" />

                <TextView
                    android:id="@+id/tvSavingsBackMaturity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/phl_white"
                    android:textSize="@dimen/text_body_md"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Lãi tích lũy dự kiến"
                    android:textColor="@color/phl_navy_on_dark_muted"
                    android:textSize="@dimen/text_body_md" />

                <TextView
                    android:id="@+id/tvSavingsBackAccrued"
                    style="@style/TextAppearance.PHL.AmountSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/phl_emerald_stroke" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="end"
                android:text="Chạm để lật lại"
                android:textColor="@color/phl_navy_on_dark_subtle"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
