<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.PHL.Card.Elevated"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_md">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_lg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="@dimen/icon_badge_size"
                android:layout_height="@dimen/icon_badge_size"
                android:background="@drawable/bg_icon_circle_navy">

                <ImageView
                    android:layout_width="@dimen/icon_size_md"
                    android:layout_height="@dimen/icon_size_md"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_m2_mortgage" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.PHL.CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Khoản vay Thế chấp" />

                <TextView
                    android:id="@+id/tvMortgageAccountNo"
                    style="@style/TextAppearance.PHL.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xxs"
                    android:ellipsize="end"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvMortgageRateBadge"
                style="@style/TextAppearance.PHL.Pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_gold"
                android:fontFeatureSettings="tnum"
                android:paddingStart="@dimen/space_sm"
                android:paddingTop="@dimen/space_xxs"
                android:paddingEnd="@dimen/space_sm"
                android:paddingBottom="@dimen/space_xxs"
                android:textColor="@color/phl_gold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvMortgageCollateral"
            style="@style/TextAppearance.PHL.BodySecondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:ellipsize="end"
            android:maxLines="2" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/hairline_height"
            android:layout_marginTop="@dimen/space_md"
            android:layout_marginBottom="@dimen/space_md"
            android:background="@color/phl_divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.PHL.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hạn mức vay" />

                <TextView
                    android:id="@+id/tvMortgageLoanAmount"
                    style="@style/TextAppearance.PHL.AmountSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xxs"
                    android:fontFeatureSettings="tnum"
                    android:text="0 VNĐ" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.PHL.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dư nợ còn lại" />

                <TextView
                    android:id="@+id/tvMortgageRemaining"
                    style="@style/TextAppearance.PHL.AmountSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xxs"
                    android:fontFeatureSettings="tnum"
                    android:text="0 VNĐ"
                    android:textColor="@color/phl_navy" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/hairline_height"
            android:layout_marginTop="@dimen/space_md"
            android:background="@color/phl_divider" />

        <LinearLayout
            android:id="@+id/btnToggleSchedule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="@dimen/space_md"
            android:paddingBottom="@dimen/space_xs">

            <TextView
                android:id="@+id/tvMortgageScheduleHeader"
                style="@style/TextAppearance.PHL.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Lịch trả nợ"
                android:textColor="@color/phl_navy"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivMortgageChevron"
                android:layout_width="@dimen/icon_size_md"
                android:layout_height="@dimen/icon_size_md"
                android:contentDescription="Mở rộng lịch trả nợ"
                android:src="@drawable/ic_m2_chevron_down" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutRepaymentSchedule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:orientation="vertical"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
