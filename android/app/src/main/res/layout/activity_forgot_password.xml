<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/phl_bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarForgot"
        style="@style/Widget.PHL.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/phl_white"
        app:title="Khôi phục mật khẩu" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_xl">

            <!-- Branded Navy Sub-Header -->
            <LinearLayout
                android:id="@+id/layoutForgotHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_navy_hero"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_lg"
                android:paddingTop="@dimen/space_base"
                android:paddingEnd="@dimen/space_lg"
                android:paddingBottom="@dimen/space_xl">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="@dimen/avatar_size_md"
                        android:layout_height="@dimen/avatar_size_md"
                        android:background="@drawable/bg_navy_crest_circle">

                        <ImageView
                            android:layout_width="@dimen/icon_size_lg"
                            android:layout_height="@dimen/icon_size_lg"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_lock"
                            app:tint="@color/phl_gold_light" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.PHL.Overline"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="BẢO MẬT &amp; KHÔI PHỤC"
                            android:textColor="@color/phl_gold_light" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xxs"
                            android:text="Xác thực OTP để thiết lập mật khẩu mới"
                            android:textColor="@color/phl_navy_on_dark_muted"
                            android:textSize="@dimen/text_body_md" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/hairline_height"
                    android:layout_marginTop="@dimen/space_base"
                    android:background="@drawable/bg_gold_hairline" />
            </LinearLayout>

            <!-- 2-Step Progress Pills -->
            <LinearLayout
                android:id="@+id/layoutForgotSteps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_base"
                android:layout_marginTop="-14dp"
                android:layout_marginEnd="@dimen/space_base"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvStepOtpBadge"
                    style="@style/TextAppearance.PHL.Pill"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_navy"
                    android:gravity="center"
                    android:paddingStart="@dimen/space_md"
                    android:paddingTop="@dimen/space_sm"
                    android:paddingEnd="@dimen/space_md"
                    android:paddingBottom="@dimen/space_sm"
                    android:text="1 · Xác thực OTP"
                    android:textColor="@color/phl_navy" />

                <TextView
                    android:id="@+id/tvStepResetBadge"
                    style="@style/TextAppearance.PHL.Pill"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_gold"
                    android:gravity="center"
                    android:paddingStart="@dimen/space_md"
                    android:paddingTop="@dimen/space_sm"
                    android:paddingEnd="@dimen/space_md"
                    android:paddingBottom="@dimen/space_sm"
                    android:text="2 · Mật khẩu mới"
                    android:textColor="@color/phl_gold" />
            </LinearLayout>

            <!-- Inline Feedback Banner (Supplements Toasts) -->
            <TextView
                android:id="@+id/tvForgotFeedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_base"
                android:layout_marginTop="@dimen/space_md"
                android:layout_marginEnd="@dimen/space_base"
                android:background="@drawable/bg_m2_success_banner"
                android:paddingStart="@dimen/space_md"
                android:paddingTop="@dimen/space_sm"
                android:paddingEnd="@dimen/space_md"
                android:paddingBottom="@dimen/space_sm"
                android:textColor="@color/phl_emerald_dark"
                android:textSize="@dimen/text_body_md"
                android:visibility="gone" />

            <!-- Step 1 Card: Request OTP -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardForgotStep1"
                style="@style/Widget.PHL.Card.Elevated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_base"
                android:layout_marginTop="@dimen/space_md"
                android:layout_marginEnd="@dimen/space_base">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg">

                    <TextView
                        style="@style/TextAppearance.PHL.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bước 1: Xác thực tài khoản" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.PHL.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:hint="@string/label_username">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtForgotUser"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="text"
                            android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.PHL.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:hint="CCCD (12 chữ số)">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtForgotIdCard"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:imeOptions="actionDone"
                            android:inputType="number"
                            android:maxLength="12"
                            android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRequestOtp"
                        style="@style/Widget.PHL.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:text="Gửi mã OTP xác thực" />

                    <ProgressBar
                        android:id="@+id/progressForgotOtp"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/space_sm"
                        android:indeterminateTint="@color/phl_navy"
                        android:indeterminateTintMode="src_in"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Step 2 Card: Confirm Reset -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardForgotStep2"
                style="@style/Widget.PHL.Card.Elevated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_base"
                android:layout_marginTop="@dimen/space_md"
                android:layout_marginEnd="@dimen/space_base">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg">

                    <TextView
                        style="@style/TextAppearance.PHL.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bước 2: Thiết lập mật khẩu mới" />

                    <TextView
                        android:id="@+id/tvOtpBanner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:background="@drawable/bg_m2_success_banner"
                        android:paddingStart="@dimen/space_md"
                        android:paddingTop="@dimen/space_sm"
                        android:paddingEnd="@dimen/space_md"
                        android:paddingBottom="@dimen/space_sm"
                        android:textColor="@color/phl_emerald_dark"
                        android:textSize="@dimen/text_body_md"
                        android:visibility="gone" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.PHL.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:hint="Mã OTP (6 chữ số)">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtForgotOtp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:imeOptions="actionNext"
                            android:inputType="number"
                            android:maxLength="6" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.PHL.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:hint="Mật khẩu mới (8–20 ký tự, hoa/thường/số/ký tự đặc biệt)"
                        app:endIconMode="password_toggle">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtForgotNewPass"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionDone"
                            android:inputType="textPassword"
                            android:maxLength="20" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnConfirmReset"
                        style="@style/Widget.PHL.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_lg"
                        android:text="Xác nhận đặt lại mật khẩu" />

                    <ProgressBar
                        android:id="@+id/progressForgotReset"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/space_sm"
                        android:indeterminateTint="@color/phl_navy"
                        android:indeterminateTintMode="src_in"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
