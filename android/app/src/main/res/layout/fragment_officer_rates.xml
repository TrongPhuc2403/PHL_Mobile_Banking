<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/phl_bg"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/layoutRatesRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_xl">

        <!-- Midnight Navy Executive Header -->
        <LinearLayout
            android:id="@+id/layoutRatesHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_navy_hero"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_xl"
            android:paddingEnd="@dimen/space_lg"
            android:paddingStart="@dimen/space_lg"
            android:paddingTop="@dimen/space_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="@dimen/avatar_size_md"
                    android:layout_height="@dimen/avatar_size_md"
                    android:background="@drawable/bg_navy_crest_circle">

                    <ImageView
                        android:layout_width="@dimen/icon_size_lg"
                        android:layout_height="@dimen/icon_size_lg"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_phl_shield"
                        app:tint="@color/phl_gold_light" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.PHL.Overline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PHL PRIVATE BANKING · TREASURY" />

                    <TextView
                        style="@style/TextAppearance.PHL.Headline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xxs"
                        android:text="Điều chỉnh Lãi suất Ngân hàng"
                        android:textColor="@color/phl_white" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/hairline_height"
                android:layout_marginTop="@dimen/space_base"
                android:background="@drawable/bg_gold_hairline" />
        </LinearLayout>

        <!-- Animated Product Mode Banner -->
        <LinearLayout
            android:id="@+id/cardRateProductBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_base"
            android:layout_marginStart="@dimen/space_base"
            android:layout_marginTop="-16dp"
            android:background="@drawable/bg_m4_savings_banner"
            android:elevation="@dimen/elevation_raised"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_lg"
            android:paddingEnd="@dimen/space_lg"
            android:paddingStart="@dimen/space_lg"
            android:paddingTop="@dimen/space_lg">

            <TextView
                android:id="@+id/tvRateBannerBadge"
                style="@style/TextAppearance.PHL.Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SẢN PHẨM TIẾT KIỆM · YIELD"
                android:textColor="@color/phl_gold_light" />

            <TextView
                android:id="@+id/tvRateBannerTitle"
                style="@style/TextAppearance.PHL.Headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="Tiết kiệm có kỳ hạn (SAVINGS)"
                android:textColor="@color/phl_white" />

            <TextView
                android:id="@+id/tvRateBannerSubtitle"
                style="@style/TextAppearance.PHL.BodySecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:fontFeatureSettings="tnum"
                android:text="Demo ID: 1 · Lãi suất hiện hành tham khảo: 5.80%/năm"
                android:textColor="@color/phl_navy_on_dark_muted" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/hairline_height"
                android:layout_marginBottom="@dimen/space_md"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_gold_hairline" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextAppearance.PHL.Caption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Mức lãi suất dự kiến áp dụng"
                    android:textColor="@color/phl_navy_on_dark_muted" />

                <TextView
                    android:id="@+id/tvRateLivePreview"
                    style="@style/TextAppearance.PHL.Amount.Hero"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:text="-- %/năm"
                    android:textSize="@dimen/text_headline" />
            </LinearLayout>
        </LinearLayout>

        <!-- Configuration Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRateForm"
            style="@style/Widget.PHL.Card.Elevated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_base"
            android:layout_marginStart="@dimen/space_base"
            android:layout_marginTop="@dimen/space_base">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/space_base"
                android:paddingEnd="@dimen/space_base"
                android:paddingStart="@dimen/space_base"
                android:paddingTop="@dimen/space_base">

                <TextView
                    style="@style/TextAppearance.PHL.Overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LOẠI SẢN PHẨM ÁP DỤNG" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipRateTarget"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipRateSavings"
                        style="@style/Widget.PHL.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Tiết kiệm (SAVINGS)" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipRateMortgage"
                        style="@style/Widget.PHL.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vay thế chấp (MORTGAGE)" />
                </com.google.android.material.chip.ChipGroup>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilRateTargetId"
                    style="@style/Widget.PHL.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:hint="ID sản phẩm (Mặc định demo: 1)">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtRateTargetId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:imeOptions="actionNext"
                        android:inputType="number"
                        android:maxLines="1"
                        android:text="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilNewInterestRate"
                    style="@style/Widget.PHL.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:hint="Lãi suất mới (%/năm, VD: 6.25)"
                    app:helperText="Giá trị hợp lệ từ 0.01 đến 30.00 %/năm">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtNewInterestRate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:imeOptions="actionDone"
                        android:inputType="numberDecimal"
                        android:maxLength="6"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.PHL.Amount.Rate" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/tvRatesError"
                    style="@style/TextAppearance.PHL.BodySecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:background="@drawable/bg_error_banner"
                    android:paddingBottom="@dimen/space_sm"
                    android:paddingEnd="@dimen/space_md"
                    android:paddingStart="@dimen/space_md"
                    android:paddingTop="@dimen/space_sm"
                    android:textColor="@color/phl_danger"
                    android:visibility="gone" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressUpdateRate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorColor="@color/phl_navy"
                    app:trackColor="@color/phl_navy_tint" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUpdateRate"
                    style="@style/Widget.PHL.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_base"
                    android:text="Cập nhật lãi suất &amp; Ghi AuditLog" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Animated Rate Confirmation Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRateSuccess"
            style="@style/Widget.PHL.Card.GoldTint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_base"
            android:layout_marginStart="@dimen/space_base"
            android:layout_marginTop="@dimen/space_md"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="@dimen/space_base"
                android:paddingEnd="@dimen/space_base"
                android:paddingStart="@dimen/space_base"
                android:paddingTop="@dimen/space_base">

                <FrameLayout
                    android:id="@+id/ivRateSuccessBadge"
                    android:layout_width="@dimen/icon_badge_size"
                    android:layout_height="@dimen/icon_badge_size"
                    android:background="@drawable/bg_icon_circle_emerald">

                    <ImageView
                        android:layout_width="@dimen/icon_size_md"
                        android:layout_height="@dimen/icon_size_md"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_check_verified"
                        app:tint="@color/phl_emerald_dark" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.PHL.Overline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ĐÃ GHI NHẬN AUDIT LOG"
                        android:textColor="@color/phl_emerald_dark" />

                    <TextView
                        android:id="@+id/tvRateSuccessSummary"
                        style="@style/TextAppearance.PHL.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xxs"
                        android:fontFeatureSettings="tnum"
                        tools:text="SAVINGS #1: 5.80% → 6.25%/năm" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
