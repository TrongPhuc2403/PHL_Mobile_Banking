<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/phl_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Luxury Midnight Navy Hero -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutLoginHero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_navy_hero"
            android:clipChildren="true">

            <View
                android:id="@+id/viewLoginHeroShimmer"
                android:layout_width="96dp"
                android:layout_height="0dp"
                android:background="@drawable/bg_shimmer_sweep"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_xl"
                android:paddingTop="@dimen/space_xxl"
                android:paddingEnd="@dimen/space_xl"
                android:paddingBottom="44dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/layoutLoginCrest"
                        android:layout_width="@dimen/avatar_size_lg"
                        android:layout_height="@dimen/avatar_size_lg"
                        android:background="@drawable/bg_navy_crest_circle">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/app_name"
                            android:src="@drawable/ic_phl_shield"
                            app:tint="@color/phl_gold_light" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.PHL.Overline"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/receipt_brand_header"
                            android:textColor="@color/phl_gold_light" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xxs"
                            android:letterSpacing="0.06"
                            android:text="@string/splash_tagline"
                            android:textColor="@color/phl_navy_on_dark_muted"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:fontFamily="sans-serif-medium"
                    android:text="Đăng nhập hệ thống"
                    android:textColor="@color/phl_white"
                    android:textSize="@dimen/text_display_md"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/login_subtitle"
                    android:textColor="@color/phl_navy_on_dark_muted"
                    android:textSize="@dimen/text_body" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/hairline_height"
                    android:layout_marginTop="@dimen/space_base"
                    android:background="@drawable/bg_gold_hairline" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Overlapping Elevated Login Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLoginForm"
            style="@style/Widget.PHL.Card.Elevated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_lg"
            android:layout_marginTop="-22dp"
            android:layout_marginEnd="@dimen/space_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.PHL.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/label_username">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtUsername"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="text"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.PHL.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:hint="@string/label_password"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/tvErrorBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:background="@drawable/bg_error_banner"
                    android:paddingStart="@dimen/space_md"
                    android:paddingTop="@dimen/space_sm"
                    android:paddingEnd="@dimen/space_md"
                    android:paddingBottom="@dimen/space_sm"
                    android:textColor="@color/phl_danger"
                    android:textSize="@dimen/text_body_md"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogin"
                    style="@style/Widget.PHL.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:text="@string/action_login" />

                <ProgressBar
                    android:id="@+id/progressLogin"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/space_md"
                    android:indeterminateTint="@color/phl_navy"
                    android:indeterminateTintMode="src_in"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvForgotPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/space_md"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="@dimen/space_md"
                    android:paddingTop="@dimen/space_sm"
                    android:paddingEnd="@dimen/space_md"
                    android:paddingBottom="@dimen/space_sm"
                    android:text="@string/action_forgot_password"
                    android:textColor="@color/phl_navy"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Polished Quick-Fill Dev Sandbox Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLoginDemo"
            style="@style/Widget.PHL.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_lg"
            android:layout_marginTop="@dimen/space_lg"
            android:layout_marginEnd="@dimen/space_lg"
            android:layout_marginBottom="@dimen/space_xl"
            app:cardBackgroundColor="@color/phl_surface_subtle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_base">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/TextAppearance.PHL.Pill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_gold"
                        android:paddingStart="@dimen/space_sm"
                        android:paddingTop="@dimen/space_xxs"
                        android:paddingEnd="@dimen/space_sm"
                        android:paddingBottom="@dimen/space_xxs"
                        android:text="DEV SANDBOX"
                        android:textColor="@color/phl_gold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_sm"
                        android:layout_weight="1"
                        android:text="Tài khoản kiểm thử nhanh (Dev)"
                        android:textColor="@color/phl_text_muted"
                        android:textSize="@dimen/text_body_sm" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDemoCustomer"
                        style="@style/Widget.PHL.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_sm"
                        android:layout_weight="1"
                        android:minHeight="@dimen/btn_height_compact"
                        android:text="Khách hàng"
                        android:textSize="@dimen/text_body_md" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDemoOfficer"
                        style="@style/Widget.PHL.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="@dimen/btn_height_compact"
                        android:text="Nhân viên"
                        android:textSize="@dimen/text_body_md" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
