PORT=8080
NODE_ENV=development
TZ=Asia/Ho_Chi_Minh

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=phl_mobile_banking

JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

EKYC_THRESHOLD_VND=10000000
OTP_EXPIRES_MINUTES=2
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

GEMINI_API_KEY=your_gemini_api_key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Local educational eKYC (not certified liveness/PAD)
EKYC_PYTHON=python
EKYC_COSINE_THRESHOLD=0.5
